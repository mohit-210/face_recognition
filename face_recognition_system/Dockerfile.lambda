# Python 3.12 Lambda images use Amazon Linux 2023, whose newer glibc supports
# the onnxruntime 1.20 wheel. Python 3.11 Lambda images are Amazon Linux 2.
FROM public.ecr.aws/lambda/python:3.12 AS build

WORKDIR /build
COPY requirements.txt ./

# InsightFace 0.7.3 is distributed as source. Its setup needs both NumPy and
# Cython; --no-build-isolation prevents pip from attempting to build an
# unpinned newer NumPy in an isolated environment.
RUN dnf install -y gcc gcc-c++ make \
    && dnf clean all \
    && pip install --no-cache-dir --target /python numpy==2.2.1 setuptools wheel Cython \
    && PYTHONPATH=/python pip install --no-cache-dir --no-build-isolation \
        --target /python -r requirements.txt

# AWS Lambda runtime image. Build tools are intentionally not copied here.
FROM public.ecr.aws/lambda/python:3.12

ENV INSIGHTFACE_HOME=/opt/insightface \
    ARCFACE_MODEL_NAME=buffalo_s \
    ARCFACE_ONNX_PROVIDERS=CPUExecutionProvider \
    ARCFACE_CTX_ID=-1 \
    ARCFACE_DET_SIZE=320 \
    OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    NUMEXPR_NUM_THREADS=2

COPY --from=build /python ${LAMBDA_TASK_ROOT}/
COPY app ${LAMBDA_TASK_ROOT}/app

# InsightFace normally downloads this model on its first inference. Lambda's
# filesystem is read-only except /tmp, so download it while building instead.
RUN python -c "from insightface.app import FaceAnalysis; model = FaceAnalysis(name='buffalo_s', root='/opt/insightface', providers=['CPUExecutionProvider']); model.prepare(ctx_id=-1, det_size=(320, 320))"

CMD ["app.lambda_handler.handler"]
